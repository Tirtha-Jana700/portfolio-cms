# replace REPLACE_WITH_YOUR_D1_DATABASE_ID with that id, save, exit{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This becomes part of your *.workers.dev URL — change it to whatever you like.
  "name": "tirtha-portfolio",
  "main": "src/worker.py",
  // Keep this as today's date when you first deploy. Cloudflare docs: set it to
  // the date you deploy on, then leave it alone — don't bump it on every deploy.
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["python_workers"],

  // Serves /public as your frontend. run_worker_first:true means every request
  // hits Flask first, so your /api/* and /media/* routes always win; anything
  // else falls through to a static file.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Your Cloudflare D1 database (the free SQL database that stores everything
  // you add from the admin panel). Create it first with:
  //   wrangler d1 create portfolio-db
  // then paste the database_id it prints below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "7e0180d8-e888-47e1-82c7-0765897a7653"
    }
  ],

  // OPTIONAL — only needed if you want to upload project/avatar images from the
  // admin panel instead of pasting image URLs. Create the bucket first with:
  //   wrangler r2 bucket create portfolio-media
  // If you don't want this, delete this whole "r2_buckets" block — the admin
  // panel will just fall back to the "paste an image URL" field.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "portfolio-media"
    }
  ]
}
